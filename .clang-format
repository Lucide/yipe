---
BasedOnStyle: LLVM
AlignArrayOfStructures: Right
ColumnLimit: 120
# BinPackInitializers: OnePerLine
# PackConstructorInitializers: CurrentLine
BinPackParameters: OnePerLine
# PackParameters: OnePerLine
QualifierAlignment: Right
IncludeCategories:
  - Regex: "^<.*>"
    Priority: 1
  - Regex: '^".*"'
    Priority: 2
