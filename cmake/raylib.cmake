include(FetchContent)

set(RAYLIB_VERSION 6.0)

FetchContent_Declare(
    raylib
    # URL https://github.com/raysan5/raylib/archive/refs/tags/${RAYLIB_VERSION}.tar.gz
    URL https://github.com/raysan5/raylib/archive/fc03d77be9f8b1141ac0f9b6b9c8ba892a5f2eb6.zip
    DOWNLOAD_EXTRACT_TIMESTAMP OFF
    SYSTEM
    EXCLUDE_FROM_ALL
    FIND_PACKAGE_ARGS
    ${RAYLIB_VERSION}
    CONFIG
)

set(PLATFORM RGFW CACHE INTERNAL "")

# prerequisite to enable options customization
set(CUSTOMIZE_BUILD ON CACHE INTERNAL "")

# subsystem modules
set(SUPPORT_MODULE_RAUDIO OFF CACHE INTERNAL "")
# set(SUPPORT_MODULE_RTEXT OFF CACHE INTERNAL "")

# input & utility systems
set(SUPPORT_GESTURES_SYSTEM OFF CACHE INTERNAL "")
set(SUPPORT_MOUSE_GESTURES OFF CACHE INTERNAL "")
set(SUPPORT_RPRAND_GENERATOR OFF CACHE INTERNAL "")
set(SUPPORT_SSH_KEYBOARD_RPI OFF CACHE INTERNAL "")
set(SUPPORT_GIF_RECORDING OFF CACHE INTERNAL "")
set(SUPPORT_COMPRESSION_API OFF CACHE INTERNAL "")
set(SUPPORT_AUTOMATION_EVENTS OFF CACHE INTERNAL "")
set(SUPPORT_CLIPBOARD_IMAGE OFF CACHE INTERNAL "")
set(SUPPORT_SCREEN_CAPTURE OFF CACHE INTERNAL "")

# module: rtextures - Configuration Flags
set(SUPPORT_FILEFORMAT_PNG OFF CACHE INTERNAL "")
set(SUPPORT_FILEFORMAT_GIF OFF CACHE INTERNAL "")
set(SUPPORT_FILEFORMAT_QOI OFF CACHE INTERNAL "")
set(SUPPORT_FILEFORMAT_DDS OFF CACHE INTERNAL "")
set(SUPPORT_FILEFORMAT_BMP OFF CACHE INTERNAL "")
set(SUPPORT_IMAGE_EXPORT OFF CACHE INTERNAL "")
set(SUPPORT_IMAGE_GENERATION OFF CACHE INTERNAL "")

# module: rtext - Configuration Flags
set(SUPPORT_FILEFORMAT_TTF OFF CACHE INTERNAL "")
set(SUPPORT_FILEFORMAT_FNT OFF CACHE INTERNAL "")
set(SUPPORT_FILEFORMAT_BDF OFF CACHE INTERNAL "")

# module: rmodels - Configuration Flags
set(SUPPORT_FILEFORMAT_OBJ OFF CACHE INTERNAL "")
set(SUPPORT_FILEFORMAT_MTL OFF CACHE INTERNAL "")
set(SUPPORT_FILEFORMAT_IQM OFF CACHE INTERNAL "")
set(SUPPORT_FILEFORMAT_GLTF OFF CACHE INTERNAL "")
set(SUPPORT_FILEFORMAT_VOX OFF CACHE INTERNAL "")
set(SUPPORT_FILEFORMAT_M3D OFF CACHE INTERNAL "")
set(SUPPORT_MESH_GENERATION OFF CACHE INTERNAL "")

FetchContent_MakeAvailable(raylib)
