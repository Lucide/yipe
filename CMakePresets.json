{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ci-windows",
      "displayName": "CI (MSVC, PTX)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-ci-vs",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "YIPE_CUDA_ARCHITECTURE": "75-virtual"
      }
    },
    {
      "name": "windows",
      "displayName": "Visual Studio Build Tools 2022 Release - amd64",
      "description": "Using compilers for Visual Studio 17 2022 (x64 architecture)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug-vs"
    }
  ],
  "buildPresets": [
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows"
    },
    {
      "name": "windows-debug",
      "displayName": "Visual Studio Build Tools 2022 Release - amd64 - Debug",
      "configurePreset": "windows",
      "configuration": "Debug"
    }
  ],
  "workflowPresets": [
    {
      "name": "ci-windows",
      "steps": [
        {
          "type": "configure",
          "name": "ci-windows"
        },
        {
          "type": "build",
          "name": "ci-windows"
        }
      ]
    }
  ]
}
