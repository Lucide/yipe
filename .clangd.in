If:
  PathMatch: .*\.(c|h)
CompileFlags:
  Add:
    # Windows MSVC support
    - --driver-mode=cl

---
# For all CUDA source and header files:
# - Force clang++ as the compiler so cl.exe is never used (important for
#   headers that clangd may "inherit" a context from main.c).
# - Mark as CUDA so clangd activates its CUDA language mode.
If:
  PathMatch: .*\.(cu|cuh)
CompileFlags:
  Remove:
    # Strip NVCC flags that cause clangd parsing errors
    - -forward-unknown-to-host-compiler
    - -Xcompiler=*
    - -Xcudafe
    - -Xfatbin*
    - -Xclang*
    - --generate-code=*
    - -gencode*
    - -ccbin*
    - -rdc=*
    - --options-file*
    - --extended-lambda
    - --display_error_number
    - -arch=*
  Add:
    # - -Wno-c++98-compat
    # - -Wno-c++98-compat-pedantic
    # - -Wno-missing-prototypes
    # - -x
    # - cuda
    # Set the path to your NVIDIA CUDA installation
    - --cuda-path=@CMAKE_CUDA_COMPILER_TOOLKIT_ROOT@
    - --cuda-gpu-arch=@YIPE_CUDA_ESTIMATED_ARCH@
