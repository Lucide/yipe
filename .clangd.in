If:
  PathMatch: .*\.(c|h)
CompileFlags:
  Add:
    # windows MSVC support
    - --driver-mode=cl
    - -Wno-unused-macros
    - -Wno-unsafe-buffer-usage
    - -Wno-declaration-after-statement
    - -Wno-c++-compat
---
If:
  # PathMatch: .*(/common\.h|\.(cu|cuh))
  PathMatch: .*\.(cu|cuh)
# Compiler: clang++
CompileFlags:
  Remove:
    # strip NVCC flags that cause clangd parsing errors
    - -forward-unknown-to-host-compiler
    - -Xcompiler*
    - -Xcudafe
    - -Xfatbin*
    - -Xclang*
    - -Xptxas*
    - --generate-code=*
    - -gencode*
    - -ccbin*
    - -rdc=*
    - --options-file*
    - --extended-lambda
    - --default-stream*
    - --display_error_number
    - -arch=*
  Add:
    - -Wall
    - -Wextra
    - -Wpedantic
    - -Wconversion
    - -Wsign-conversion
    - -Wno-c++17-attribute-extensions

    # workaround since cuda seems to directly intercept assert(calls)
    - -DNDEBUG
    - -Wno-c++98-compat
    - -Wno-c++98-compat-pedantic
    # - -Wno-missing-prototypes
    - -x
    - cuda
    - --cuda-path=@CMAKE_CUDA_COMPILER_TOOLKIT_ROOT@
    - --cuda-gpu-arch=@YIPE_CUDA_ESTIMATED_ARCH@
